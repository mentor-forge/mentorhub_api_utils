#!/usr/bin/env sh
# Prepare the immutable version tag on the intended main commit.
set -eu

fail() { printf '%s\n' "$*" >&2; exit 1; }

case "${1:-}" in
  "") [ "$#" -eq 0 ] || fail "Usage: tag-release [--no-push]" ;;
  --no-push) [ "$#" -eq 1 ] || fail "Usage: tag-release [--no-push]" ;;
  *) fail "Usage: tag-release [--no-push]" ;;
esac

cd "$(dirname "$0")/.."
version=$(sed -nE 's/^version = "([0-9]+\.[0-9]+\.[0-9]+)"$/\1/p' pyproject.toml)
[ -n "$version" ] || fail 'Could not find version = "X.Y.Z" in pyproject.toml'
tag="v$version"
ref="refs/tags/$tag"

[ "$(git branch --show-current)" = main ] || fail "Release tags must be prepared on main."
[ -z "$(git status --porcelain)" ] || fail "Working tree must be clean before tagging."
commit=$(git rev-parse HEAD)
remote_main=$(git ls-remote --exit-code origin refs/heads/main) || fail "Could not verify main on origin."
[ "$(printf '%s\n' "$remote_main" | cut -f1)" = "$commit" ] || fail "HEAD must match main on origin."
if git show-ref --verify --quiet "$ref"; then
  fail "Tag $tag already exists locally."
fi
remote_tag=$(git ls-remote --tags origin "$ref") || fail "Could not verify tags on origin."
[ -z "$remote_tag" ] || fail "Tag $tag already exists on origin."
release_tags=$(gh api --paginate 'repos/mentor-forge/mentorhub_api_utils/releases?per_page=100' --jq '.[].tag_name') ||
  fail "Could not verify GitHub Release state."
if printf '%s\n' "$release_tags" | grep -Fxq "$tag"; then
  fail "GitHub Release $tag already exists."
fi

git tag "$tag" "$commit"
printf 'Created tag %s for API Utils %s.\n' "$tag" "$version"
if [ "${1:-}" = --no-push ]; then
  printf 'When ready, push with: git push origin %s\n' "$ref"
else
  git push origin "$ref"
  printf 'Pushed %s. GitHub Actions will build and publish the release.\n' "$tag"
fi
